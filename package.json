{
  "name": "better-content",
  "version": "0.10.0",
  "description": "Framework-neutral, own-your-data, adapter-driven inline-edit CMS engine.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./adapters/postgres": {
      "import": {
        "types": "./dist/adapters/postgres.d.ts",
        "default": "./dist/adapters/postgres.js"
      },
      "require": {
        "types": "./dist/adapters/postgres.d.cts",
        "default": "./dist/adapters/postgres.cjs"
      }
    },
    "./adapters/firestore": {
      "import": {
        "types": "./dist/adapters/firestore.d.ts",
        "default": "./dist/adapters/firestore.js"
      },
      "require": {
        "types": "./dist/adapters/firestore.d.cts",
        "default": "./dist/adapters/firestore.cjs"
      }
    },
    "./storage/cloudinary": {
      "import": {
        "types": "./dist/storage/cloudinary.d.ts",
        "default": "./dist/storage/cloudinary.js"
      },
      "require": {
        "types": "./dist/storage/cloudinary.d.cts",
        "default": "./dist/storage/cloudinary.cjs"
      }
    },
    "./storage/cloudinary/server": {
      "import": {
        "types": "./dist/storage/cloudinary/server.d.ts",
        "default": "./dist/storage/cloudinary/server.js"
      },
      "require": {
        "types": "./dist/storage/cloudinary/server.d.cts",
        "default": "./dist/storage/cloudinary/server.cjs"
      }
    },
    "./auth/firebase": {
      "import": {
        "types": "./dist/auth/firebase.d.ts",
        "default": "./dist/auth/firebase.js"
      },
      "require": {
        "types": "./dist/auth/firebase.d.cts",
        "default": "./dist/auth/firebase.cjs"
      }
    },
    "./auth/firebase/client": {
      "import": {
        "types": "./dist/auth/firebase/client.d.ts",
        "default": "./dist/auth/firebase/client.js"
      },
      "require": {
        "types": "./dist/auth/firebase/client.d.cts",
        "default": "./dist/auth/firebase/client.cjs"
      }
    },
    "./auth/google": {
      "import": {
        "types": "./dist/auth/google.d.ts",
        "default": "./dist/auth/google.js"
      },
      "require": {
        "types": "./dist/auth/google.d.cts",
        "default": "./dist/auth/google.cjs"
      }
    },
    "./auth/google/client": {
      "import": {
        "types": "./dist/auth/google/client.d.ts",
        "default": "./dist/auth/google/client.js"
      },
      "require": {
        "types": "./dist/auth/google/client.d.cts",
        "default": "./dist/auth/google/client.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools.d.ts",
        "default": "./dist/devtools.js"
      },
      "require": {
        "types": "./dist/devtools.d.cts",
        "default": "./dist/devtools.cjs"
      }
    },
    "./devtools/react": {
      "import": {
        "types": "./dist/devtools/react.d.ts",
        "default": "./dist/devtools/react.js"
      },
      "require": {
        "types": "./dist/devtools/react.d.cts",
        "default": "./dist/devtools/react.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
