      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "./dist/core.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "server": [
        "./dist/server.d.ts"
      ],
      "adapters/postgres": [
        "./dist/adapters/postgres.d.ts"
      ],
      "adapters/firestore": [
        "./dist/adapters/firestore.d.ts"
      ],
      "storage/cloudinary": [
        "./dist/storage/cloudinary.d.ts"
      ],
      "storage/cloudinary/server": [
        "./dist/storage/cloudinary/server.d.ts"
      ],
      "auth/firebase": [
        "./dist/auth/firebase.d.ts"
      ],
      "auth/firebase/client": [
        "./dist/auth/firebase/client.d.ts"
      ],
      "auth/google": [
        "./dist/auth/google.d.ts"
      ],
      "auth/google/client": [
        "./dist/auth/google/client.d.ts"
      ],
      "devtools": [
        "./dist/devtools.d.ts"
      ],
      "devtools/react": [
        "./dist/devtools/react.d.ts"
      ],
      "svelte": [
        "./dist/svelte.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "@react-oauth/google": ">=0.12",
    "cloudinary": ">=2",
    "drizzle-orm": ">=0.40",
    "firebase": ">=10",
    "firebase-admin": ">=12",
    "pg": ">=8",
    "react": ">=18",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "cloudinary": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@react-oauth/google": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "merge:staging": "sh scripts/merge-staging.sh"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "inline-editing",
    "content-management"
  ],
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@react-oauth/google": "^0.13.5",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40"
  }
}
