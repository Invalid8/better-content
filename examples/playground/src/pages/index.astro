---
import Base from "../layouts/Base.astro";
import CodeTabs from "../components/CodeTabs.astro";
import DatabaseRows from "../components/DatabaseRows.astro";
import AdapterCalls from "../components/AdapterCalls.astro";
import HeroIsland from "../components/react/HeroIsland";
import RowsIsland from "../components/react/RowsIsland";
import ReactNoteIsland from "../components/react/NoteIsland";
import VueNoteIsland from "../components/vue/NoteIsland.vue";
import SvelteNoteIsland from "../components/svelte/NoteIsland.svelte";
import { ArrowRight, Copy, Pencil } from "@lucide/astro";

import engineSource from "../lib/engine.ts?raw";
import pgliteAdapterSource from "../snippets/adapters/pglite.ts?raw";
import memoryAdapterSource from "../snippets/adapters/memory.ts?raw";
import restAdapterSource from "../snippets/adapters/rest.ts?raw";
import reactNoteSource from "../components/react/NoteCard.tsx?raw";
import vueNoteSource from "../components/vue/NoteCard.vue?raw";
import svelteNoteSource from "../components/svelte/NoteCard.svelte?raw";

const steps = [
  {
    keys: ["⌘", "E"],
    copy: "Turn on edit mode. Every field on this page becomes editable in place, headings and body copy included.",
  },
  {
    keys: [],
    copy: "Click anything and type. No admin panel, no modal, no second URL to remember.",
  },
  {
    keys: ["⌘", "S"],
    copy: "Save every dirty field in one round trip. Volatile adapters skip this and save on blur.",
  },
  {
    keys: [],
    copy: "Open the database panel below. The row you just changed is sitting in Postgres.",
  },
  {
    keys: [],
    copy: "Reload. It is still there, because PGlite persists to IndexedDB, in your tab, with no server.",
  },
];

const contract = [
  ["fetchCollection", "(collection, q?)", "read"],
  ["fetchById", "(collection, id)", "read"],
  ["create", "(collection, data)", "write"],
  ["createWithId", "(collection, id, data)", "write"],
  ["update", "(collection, id, patch)", "write"],
  ["upsert", "(collection, id, patch)", "write"],
  ["delete", "(collection, id)", "write"],
];
---

<Base
  title="better-content, an inline-edit CMS engine"
  description="better-content puts editing on the page itself and writes every change to a database you own, through a seven-method adapter, from React, Vue or Svelte."
>
  <main>
    <section class="hero">
      <div class="shell">
        <p class="chip">Inline-edit CMS engine</p>
        <HeroIsland client:only="react">
          <Fragment slot="fallback">
            <div class="hero-skeleton" aria-hidden="true">
              <span class="hero-skeleton__title"></span>
              <span class="hero-skeleton__title"></span>
              <span class="hero-skeleton__deck"></span>
              <span class="hero-skeleton__deck"></span>
              <span class="hero-skeleton__deck"></span>
            </div>
          </Fragment>
        </HeroIsland>
        <div class="hero__actions">
          <button class="button button--mark when-reading" id="hero-edit" type="button">
            <Pencil aria-hidden="true" size={16} stroke-width={1.9} />
            <span>Turn on edit mode</span>
            <kbd><span class="kbd-mod">⌘</span>E</kbd>
          </button>
          <button class="command" id="copy-create" type="button">
            <span class="command__prompt">$</span>
            <code>npm create better-content</code>
            <Copy aria-hidden="true" size={15} stroke-width={1.8} />
          </button>
        </div>
      </div>
    </section>

    <section class="section" id="try">
      <div class="shell">
        <header class="section__head">
          <p class="chip">01 — Try it</p>
          <h2>There is no demo mode. This is the app.</h2>
          <p class="section__deck">
            Every keystroke you make on this page runs the same code path a
            production app runs: engine, transport, adapter, your database.
          </p>
        </header>

        <ol class="steps">
          {
            steps.map((step) => (
              <li class="step">
                <span class="step__copy">{step.copy}</span>
                {step.keys.length > 0 && (
                  <span class="step__keys">
                    {step.keys.map((key) => (
                      <kbd>{key}</kbd>
                    ))}
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section" id="database">
      <div class="shell">
        <header class="section__head section__head--split">
          <div>
            <p class="chip">02 — Where it went</p>
            <h2>Your edit is a row. Here it is.</h2>
            <p class="section__deck">
              Content is rows, not commits. That is the difference between this
              and a git-backed CMS: it works for apps, not only static sites.
            </p>
          </div>
          <button class="button button--quiet" type="button" id="reset-demo">
            Reset data
          </button>
        </header>

        <div class="db-panel">
          <div class="db-panel__bar">
            <span class="db-panel__title">database</span>
            <label class="adapter-switch">
              <span>adapter</span>
              <select id="adapter-select"></select>
            </label>
          </div>
          <div class="db-panel__body">
            <DatabaseRows />
            <AdapterCalls />
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="rows">
      <div class="shell">
        <header class="section__head">
          <p class="chip">03 — Beyond text</p>
          <h2>Insert a row. Drag it. Delete it. Drop in an image.</h2>
          <p class="section__deck">
            The same engine that edits a field also creates, reorders and
            deletes records. Every op updates the snapshot immediately and rolls
            back if the adapter rejects the write. Turn on edit mode to get the
            controls.
          </p>
        </header>
        <RowsIsland client:only="react" />
      </div>
    </section>

    <section class="section" id="bindings">
      <div class="shell">
        <header class="section__head">
          <p class="chip">04 — Bindings</p>
          <h2>Edit in React. Watch Vue and Svelte.</h2>
          <p class="section__deck">
            These are three real islands on one page, each a different
            framework, all subscribed to the same engine. Type into any of them
            and the other two re-render before the save even lands.
          </p>
        </header>

        <div class="islands">
          <ReactNoteIsland client:only="react" />
          <VueNoteIsland client:only="vue" />
          <SvelteNoteIsland client:only="svelte" />
        </div>

        <div class="engine-bar">
          <code
            >const engine = createCmsEngine(&#123; transport:
            adapterTransport(adapter) &#125;)</code
          >
          <span>framework-free, zero framework imports</span>
        </div>

        <CodeTabs
          label="Binding sources"
          files={[
            { name: "React", code: reactNoteSource },
            { name: "Vue", code: vueNoteSource },
            { name: "Svelte", code: svelteNoteSource },
          ]}
        />
      </div>
    </section>

    <section class="section" id="adapters">
      <div class="shell">
        <header class="section__head">
          <p class="chip">05 — Adapters</p>
          <h2>Seven methods stand between us and your database.</h2>
          <p class="section__deck">
            There is no hosted service to sign up for and no proprietary backend
            to migrate off. Implement these seven and better-content talks to
            whatever you already run.
          </p>
        </header>

        <div class="adapters">
          <div class="contract">
            <p class="contract__head">interface DataAdapter</p>
            {
              contract.map(([name, signature, kind]) => (
                <div class="contract__row">
                  <code>{name}</code>
                  <span class="contract__sig">{signature}</span>
                  <span class="contract__kind" data-kind={kind}>
                    {kind}
                  </span>
                </div>
              ))
            }
            <p class="contract__foot">
              An afternoon of work for a database you already know.
            </p>
          </div>

          <CodeTabs
            label="Adapter sources"
            files={[
              { name: "engine.ts", code: engineSource },
              { name: "pglite.ts", code: pgliteAdapterSource },
              { name: "memory.ts", code: memoryAdapterSource },
              { name: "rest.ts", code: restAdapterSource },
            ]}
          />
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="shell">
        <h2>Take it home.</h2>
        <p>
          Scaffold a Next.js, Nuxt, SvelteKit or Astro app wired to Postgres or
          Firestore. MIT licensed, pre-1.0, no account required.
        </p>
        <div class="closing__actions">
          <button class="command command--ink" id="copy-create-2" type="button">
            <span class="command__prompt">$</span>
            <code>npm create better-content</code>
            <Copy aria-hidden="true" size={15} stroke-width={1.8} />
          </button>
          <a
            class="button button--quiet"
            href="https://better-content-docs.vercel.app"
            target="_blank"
            rel="noreferrer"
          >
            <span>Read the docs</span>
            <ArrowRight aria-hidden="true" size={15} stroke-width={1.8} />
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    import {
      activeAdapterId,
      adapterOptions,
      loadAdapter,
      resetDemo,
      setAdapter,
    } from "../lib/db";
    import { ready } from "../lib/engine";
    import { editMode } from "../lib/editMode";
    import {
      registerDataInspector,
      type DataInspectorElement,
    } from "better-content/devtools";

    registerDataInspector();
    const inspector =
      (document.querySelector(
        "better-content-inspector",
      ) as DataInspectorElement | null) ??
      (document.createElement(
        "better-content-inspector",
      ) as DataInspectorElement);
    inspector.collections = ["page", "cards"];
    if (!inspector.isConnected) document.body.append(inspector);
    void loadAdapter().then((adapter) => {
      inspector.adapter = adapter;
    });
    void ready.then((engine) => {
      inspector.engine = engine;
    });

    document
      .getElementById("hero-edit")
      ?.addEventListener("click", editMode.toggle);

    const adapterSelect = document.getElementById(
      "adapter-select",
    ) as HTMLSelectElement | null;

    if (adapterSelect) {
      for (const option of adapterOptions) {
        const item = document.createElement("option");
        item.value = option.id;
        item.textContent = option.label;
        item.selected = option.id === activeAdapterId;
        adapterSelect.append(item);
      }
      adapterSelect.addEventListener("change", () => {
        setAdapter(adapterSelect.value as typeof activeAdapterId);
      });
    }

    document
      .getElementById("reset-demo")
      ?.addEventListener("click", () => void resetDemo());

    for (const id of ["copy-create", "copy-create-2"]) {
      document.getElementById(id)?.addEventListener("click", (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const label = button.querySelector("code")!;
        void navigator.clipboard
          ?.writeText("npm create better-content")
          .then(() => {
            const original = label.textContent;
            label.textContent = "copied";
            setTimeout(() => (label.textContent = original), 1200);
          });
      });
    }

    if (activeAdapterId !== "pglite") {
      void ready.then((engine) => {
        let timer: number | undefined;
        engine.subscribe(() => {
          const { hasUnsavedChanges, saving } = engine.getSnapshot();
          if (hasUnsavedChanges && !saving) {
            clearTimeout(timer);
            timer = window.setTimeout(() => void engine.saveAll(), 300);
          }
        });
      });
    }
  </script>
</Base>
